<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- XAMPP default: user root, empty password. For LAN use, change Server=localhost to the server PC's IP. -->
    <add name="CsuAttendance"
         connectionString="Server=localhost;Port=3306;Database=csu_attendance;User ID=root;Password=;SslMode=None;ConvertZeroDateTime=True;Default Command Timeout=30" />
  </connectionStrings>
</configuration>
